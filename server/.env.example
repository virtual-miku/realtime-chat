# Azure SignalR Service — ambil dari: az signalr key list
SIGNALR_CONNECTION_STRING=Endpoint=https://<signalr-name>.service.signalr.net;AccessKey=<access-key>;Version=1.0;

# Azure Communication Services — ambil dari: az communication list-key
ACS_CONNECTION_STRING=endpoint=https://<acs-name>.communication.azure.com/;accesskey=<access-key>;